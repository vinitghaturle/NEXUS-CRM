// Setup.gs — Spreadsheet initialization and schema enforcement.
// Contains setupNexusSpreadsheet() to build the database from scratch idempotently.

/**
 * Main entry point for spreadsheet initialization.
 * Creates all 22 tabs, sets up headers, formats columns, adds dropdown validations,
 * configures status conditional formatting, and protects administrative ranges.
 */
function setupNexusSpreadsheet() {
  var ss;
  
  // 1. Get or create spreadsheet
  if (typeof SPREADSHEET_ID !== 'undefined' && SPREADSHEET_ID) {
    try {
      ss = SpreadsheetApp.openById(SPREADSHEET_ID);
      Logger.log("Using configured Spreadsheet ID: " + SPREADSHEET_ID);
    } catch (e) {
      Logger.log("Failed to open spreadsheet by ID: " + e.toString());
    }
  }
  
  if (!ss) {
    try {
      ss = SpreadsheetApp.getActiveSpreadsheet();
      Logger.log("Using active bound spreadsheet: " + ss.getName());
    } catch (e) {
      Logger.log("No active spreadsheet found. Creating a new one...");
      ss = SpreadsheetApp.create("NEXUS CRM — 2026–27");
      Logger.log("Created a new spreadsheet. ID: " + ss.getId());
      Logger.log("IMPORTANT: Please update SPREADSHEET_ID in Config.gs with this ID: " + ss.getId());
    }
  }
  
  if (!ss) {
    throw new Error("Could not initialize spreadsheet. Verify permissions or SPREADSHEET_ID in Config.gs.");
  }

  // Define schemas for all 22 tabs
  var schemas = {
    "00_Settings": ["settingKey", "settingValue", "description", "active"],
    "01_Users": ["userId", "firebaseUid", "name", "email", "phone", "role", "teamId", "position", "active", "joinDate", "profilePhotoUrl", "createdAt", "updatedAt"],
    "02_Teams": ["teamId", "teamName", "teamCode", "leadUserId", "description", "active", "createdAt", "updatedAt"],
    "03_Events": ["eventId", "eventName", "eventCategory", "eventDate", "startTime", "endTime", "venue", "leadTeamId", "supportingTeamIds", "eventStatus", "description", "createdBy", "createdAt", "updatedAt", "registrationStartDate", "registrationEndDate", "permissionDeadline", "creativeDeadline", "formDeadline", "promotionStartDate", "eventReportDeadline", "driveFolderUrl"],
    "04_Tasks": ["taskId", "eventId", "projectId", "taskTitle", "taskDescription", "teamId", "assignedTo", "assignedBy", "verifierId", "priority", "startDate", "deadline", "status", "completionPercent", "remarks", "rejectionRemarks", "completionDate", "driveLink", "isAutoGenerated", "sourceTemplateId", "createdAt", "updatedAt"],
    "05_Task_Updates": ["updateId", "taskId", "updatedBy", "previousStatus", "newStatus", "previousCompletion", "newCompletion", "remarks", "updatedAt"],
    "06_Creative": ["creativeId", "eventId", "creativeType", "title", "designerId", "contentOwnerId", "contentReceived", "designStarted", "reviewStatus", "approved", "published", "deadline", "postingDate", "assetUrl", "remarks", "createdAt", "updatedAt"],
    "07_Social_Media": ["contentId", "contentType", "eventId", "title", "platform", "responsiblePerson", "contentDeadline", "designDeadline", "approvalStatus", "postingDate", "status", "publishedUrl", "remarks", "createdAt", "updatedAt"],
    "08_Newsletter": ["newsletterId", "month", "year", "theme", "contentOwner", "designer", "deadline", "approvalStatus", "published", "publishedDate", "driveUrl", "remarks"],
    "09_Birthdays": ["birthdayId", "facultyName", "department", "birthday", "month", "posterAssigned", "contentAssigned", "designDeadline", "approvalStatus", "postingDate", "status", "remarks"],
    "10_Achievements": ["achievementId", "name", "department", "achievement", "category", "achievementDate", "proofUrl", "contentWriterId", "designerId", "approvalStatus", "postingDate", "instagramUrl", "createdAt", "updatedAt"],
    "11_Forms": ["formId", "formName", "eventId", "ownerId", "creationDeadline", "launchDate", "closingDate", "responseCount", "status", "formUrl", "responseSheetUrl", "createdAt", "updatedAt"],
    "12_Issues": ["issueId", "issueTitle", "eventId", "teamId", "severity", "dateRaised", "actionRequired", "ownerId", "deadline", "resolution", "status", "createdBy", "createdAt", "updatedAt"],
    "13_Meetings": ["meetingId", "meetingDate", "meetingType", "agenda", "decision", "responsiblePerson", "deadline", "status", "remarks", "createdBy", "createdAt"],
    "14_Budget": ["budgetId", "eventId", "category", "description", "estimatedBudget", "actualExpense", "amountPaid", "pendingAmount", "vendor", "sponsor", "invoiceUrl", "approvalStatus", "approvedBy", "createdAt", "updatedAt"],
    "15_Recognition": ["recognitionId", "userId", "recognitionType", "month", "year", "reason", "eventId", "volunteerHours", "approvedBy", "certificateUrl", "createdAt"],
    "16_Documents": ["documentId", "eventId", "documentType", "documentName", "driveUrl", "uploadedBy", "uploadedAt", "description"],
    "17_Reports": ["reportId", "reportType", "periodStart", "periodEnd", "generatedAt", "generatedBy", "summary", "reportUrl"],
    "18_Performance": ["performanceId", "userId", "period", "taskCompletionScore", "onTimeScore", "eventParticipationScore", "meetingAttendanceScore", "initiativeScore", "teamCoordinationScore", "responsibilityScore", "communicationScore", "qualityScore", "consistencyScore", "overallScore", "remarks", "evaluatedBy", "evaluatedAt"],
    "19_Audit_Log": ["auditId", "timestamp", "userId", "action", "entityType", "entityId", "previousValue", "newValue", "ipOrSessionReference", "result"],
    "20_Event_Templates": ["templateId", "templateName", "taskTitle", "taskDescription", "dayOffset", "teamId", "defaultPriority", "required", "active"],
    "21_Dashboard_Data": ["metricKey", "metricValue", "calculatedAt"],
    "22_Notifications": ["notificationId", "eventType", "taskId", "eventId", "recipientUserId", "recipientEmail", "subject", "status", "sentAt", "errorMessage", "createdAt"]
  };

  var tabOrder = [
    "00_Settings", "01_Users", "02_Teams", "03_Events", "04_Tasks", "05_Task_Updates",
    "06_Creative", "07_Social_Media", "08_Newsletter", "09_Birthdays", "10_Achievements",
    "11_Forms", "12_Issues", "13_Meetings", "14_Budget", "15_Recognition", "16_Documents",
    "17_Reports", "18_Performance", "19_Audit_Log", "20_Event_Templates", "21_Dashboard_Data",
    "22_Notifications"
  ];

  // 2. Idempotent sheet creation
  for (var index = 0; index < tabOrder.length; index++) {
    var sheetName = tabOrder[index];
    var columns = schemas[sheetName];
    var sheet = ss.getSheetByName(sheetName);
    
    if (!sheet) {
      sheet = ss.insertSheet(sheetName);
      Logger.log("Created sheet: " + sheetName);
    } else {
      Logger.log("Sheet already exists, enforcing schema: " + sheetName);
    }
    
    // Set sheet order/index
    sheet.activate();
    ss.moveActiveSheet(index + 1);
    
    // Set headers
    sheet.getRange(1, 1, 1, columns.length).setValues([columns]);
    sheet.getRange(1, 1, 1, columns.length).setFontWeight("bold");
    sheet.setHiddenGridlines(false);
    
    // Freeze header
    sheet.setFrozenRows(1);
    
    // Create filter on headers (if none exists)
    var filter = sheet.getFilter();
    if (!filter) {
      sheet.getRange(1, 1, sheet.getMaxRows(), columns.length).createFilter();
    }
    
    // Set column date formatting programmatically
    applyNumberFormats(sheet, columns);
    
    // Protect header range idempotently
    var rangeProtections = sheet.getProtections(SpreadsheetApp.ProtectionType.RANGE);
    var headerProtected = false;
    for (var p = 0; p < rangeProtections.length; p++) {
      if (rangeProtections[p].getDescription() === "Header Protection") {
        headerProtected = true;
        break;
      }
    }
    if (!headerProtected) {
      var headerRange = sheet.getRange(1, 1, 1, columns.length);
      var headerProtection = headerRange.protect().setDescription("Header Protection");
      var me = Session.getEffectiveUser();
      headerProtection.addEditor(me);
      headerProtection.removeEditors(headerProtection.getEditors());
      if (headerProtection.canDomainEdit()) {
        headerProtection.setDomainEdit(false);
      }
    }
  }

  // 3. Remove default "Sheet1" if present
  var defaultSheet = ss.getSheetByName("Sheet1");
  if (defaultSheet) {
    try {
      ss.deleteSheet(defaultSheet);
      Logger.log("Deleted default Sheet1.");
    } catch (e) {
      Logger.log("Could not delete default Sheet1: " + e.toString());
    }
  }

  // 4. Seeding static configuration sheets
  seedSettings(ss);
  seedTeams(ss);
  seedTemplates(ss);

  // 5. Apply dropdown validations
  applyAllDropdownValidations(ss);

  // 6. Apply status conditional formatting
  var tasksSheet = ss.getSheetByName("04_Tasks");
  if (tasksSheet) {
    applyStatusConditionalFormatting(tasksSheet, 12); // column 12 = status
  }
  
  var creativeSheet = ss.getSheetByName("06_Creative");
  if (creativeSheet) {
    applyCreativeStatusFormatting(creativeSheet, 9); // column 9 = reviewStatus
  }

  // 7. Protect Administrative Sheets (00_Settings, 01_Users, 18_Performance, 19_Audit_Log, 21_Dashboard_Data)
  var protectedSheets = ["00_Settings", "01_Users", "18_Performance", "19_Audit_Log", "21_Dashboard_Data"];
  for (var s = 0; s < protectedSheets.length; s++) {
    var pSheet = ss.getSheetByName(protectedSheets[s]);
    if (pSheet) {
      var sheetProtections = pSheet.getProtections(SpreadsheetApp.ProtectionType.SHEET);
      var isSheetProtected = false;
      for (var sp = 0; sp < sheetProtections.length; sp++) {
        isSheetProtected = true;
        break;
      }
      if (!isSheetProtected) {
        var sheetProtection = pSheet.protect().setDescription("System protected sheet");
        var me = Session.getEffectiveUser();
        sheetProtection.addEditor(me);
        sheetProtection.removeEditors(sheetProtection.getEditors());
        if (sheetProtection.canDomainEdit()) {
          sheetProtection.setDomainEdit(false);
        }
        Logger.log("Protected sheet: " + protectedSheets[s]);
      }
    }
  }

  Logger.log("setupNexusSpreadsheet completed successfully.");
}

/**
 * Formats cells based on column names.
 */
function applyNumberFormats(sheet, columns) {
  for (var c = 0; c < columns.length; c++) {
    var colName = columns[c];
    var colLower = colName.toLowerCase();
    var columnIndex = c + 1;
    var range = sheet.getRange(2, columnIndex, sheet.getMaxRows() - 1, 1);
    
    if (colLower.endsWith("date") || colLower.endsWith("deadline") || colLower === "birthday") {
      range.setNumberFormat("dd/MM/yyyy");
    } else if (colLower.endsWith("at") || colLower === "timestamp") {
      range.setNumberFormat("dd/MM/yyyy HH:mm:ss");
    }
  }
}

/**
