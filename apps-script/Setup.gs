    { sheet: "01_Users", col: 9, list: ["TRUE", "FALSE"] },
    
    { sheet: "02_Teams", col: 6, list: ["TRUE", "FALSE"] },
    
    { sheet: "03_Events", col: 10, list: ["PLANNING", "UPCOMING", "ONGOING", "COMPLETED", "CANCELLED", "POSTPONED"] },
    
    { sheet: "04_Tasks", col: 9, list: ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    { sheet: "04_Tasks", col: 12, list: ["NOT_STARTED", "IN_PROGRESS", "COMPLETED", "DELAYED", "BLOCKED", "CANCELLED"] },
    { sheet: "04_Tasks", col: 17, list: ["TRUE", "FALSE"] },
    
    { sheet: "06_Creative", col: 9, list: ["BRIEF", "CONTENT_RECEIVED", "DESIGN_STARTED", "REVIEW", "APPROVED", "PUBLISHED"] },
    { sheet: "06_Creative", col: 10, list: ["TRUE", "FALSE"] },
    { sheet: "06_Creative", col: 11, list: ["TRUE", "FALSE"] },
    
    { sheet: "07_Social_Media", col: 2, list: ["POST", "REEL", "STORY", "EVENT_PROMOTION", "COUNTDOWN", "BIRTHDAY", "ACHIEVEMENT", "FACULTY_FEATURE", "STUDENT_SPOTLIGHT", "NEWSLETTER", "EVENT_RECAP"] },
    { sheet: "07_Social_Media", col: 9, list: ["PENDING", "APPROVED", "REJECTED"] },
    { sheet: "07_Social_Media", col: 11, list: ["PLANNING", "DRAFT", "REVIEW", "SCHEDULED", "PUBLISHED"] },
    
    { sheet: "08_Newsletter", col: 8, list: ["PENDING", "APPROVED", "REJECTED"] },
    { sheet: "08_Newsletter", col: 9, list: ["TRUE", "FALSE"] },
    
    { sheet: "09_Birthdays", col: 9, list: ["PENDING", "APPROVED", "REJECTED"] },
    { sheet: "09_Birthdays", col: 11, list: ["PLANNING", "DESIGNED", "PUBLISHED", "SKIPPED"] },
    
    { sheet: "10_Achievements", col: 10, list: ["PENDING", "APPROVED", "REJECTED"] },
    
    { sheet: "11_Forms", col: 9, list: ["PLANNING", "CREATING", "ACTIVE", "CLOSED", "ARCHIVED"] },
    
    { sheet: "12_Issues", col: 5, list: ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    { sheet: "12_Issues", col: 11, list: ["OPEN", "IN_PROGRESS", "RESOLVED", "CLOSED"] },
    
    { sheet: "13_Meetings", col: 8, list: ["SCHEDULED", "COMPLETED", "CANCELLED"] },
    
    { sheet: "14_Budget", col: 12, list: ["PENDING", "APPROVED", "REJECTED"] },
    
    { sheet: "15_Recognition", col: 3, list: ["MEMBER_OF_MONTH", "BEST_VOLUNTEER", "BEST_TEAM", "OUTSTANDING_CONTRIBUTION"] },
    
    { sheet: "17_Reports", col: 2, list: ["WEEKLY", "MONTHLY", "EVENT", "SEMESTER", "ANNUAL"] },
    
    { sheet: "20_Event_Templates", col: 7, list: ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    { sheet: "20_Event_Templates", col: 8, list: ["TRUE", "FALSE"] },
    { sheet: "20_Event_Templates", col: 9, list: ["TRUE", "FALSE"] }
  ];

  for (var i = 0; i < dropdownConfigs.length; i++) {
    var conf = dropdownConfigs[i];
    var sheet = ss.getSheetByName(conf.sheet);
    if (sheet) {
      var range = sheet.getRange(2, conf.col, sheet.getMaxRows() - 1, 1);
      var rule = SpreadsheetApp.newDataValidation()
        .requireValueInList(conf.list, true)
        .setAllowInvalid(false)
        .setHelpText("Value must be one of: " + conf.list.join(", "))
        .build();
      range.setDataValidation(rule);
    }
  }
  Logger.log("Applied cell validations across sheets.");
}

/**
 * Apply task status conditional formatting.
 */
function applyStatusConditionalFormatting(sheet, colIndex) {
  var range = sheet.getRange(2, colIndex, sheet.getMaxRows() - 1, 1);
  var rules = [];

  // Rule 1: COMPLETED -> light green background, dark green text
  rules.push(SpreadsheetApp.newConditionalFormatRule()
    .whenTextEqualTo("COMPLETED")
    .setBackground("#e2f0d9")
    .setFontColor("#385723")
    .setRanges([range])
    .build());

  // Rule 2: IN_PROGRESS -> light yellow background, dark yellow text
  rules.push(SpreadsheetApp.newConditionalFormatRule()
    .whenTextEqualTo("IN_PROGRESS")
    .setBackground("#fff2cc")
    .setFontColor("#7f6000")
    .setRanges([range])
    .build());

  // Rule 3: NOT_STARTED -> light blue background, dark blue text
  rules.push(SpreadsheetApp.newConditionalFormatRule()
    .whenTextEqualTo("NOT_STARTED")
    .setBackground("#ddebf7")
    .setFontColor("#1f4e78")
    .setRanges([range])
    .build());

  // Rule 4: DELAYED -> light red background, dark red text
  rules.push(SpreadsheetApp.newConditionalFormatRule()
    .whenTextEqualTo("DELAYED")
    .setBackground("#fce4d6")
    .setFontColor("#c00000")
    .setRanges([range])
    .build());

  // Rule 5: BLOCKED -> dark red background, white text
  rules.push(SpreadsheetApp.newConditionalFormatRule()
    .whenTextEqualTo("BLOCKED")
    .setBackground("#800000")
    .setFontColor("#ffffff")
    .setRanges([range])
    .build());

  sheet.setConditionalFormatRules(rules);
  Logger.log("Applied task status conditional formatting rules.");
}

/**
 * Apply creative status conditional formatting.
 */
function applyCreativeStatusFormatting(sheet, colIndex) {
  var range = sheet.getRange(2, colIndex, sheet.getMaxRows() - 1, 1);
  var rules = [];

  // APPROVED / PUBLISHED -> light green
  rules.push(SpreadsheetApp.newConditionalFormatRule()
    .whenTextEqualTo("APPROVED")
    .setBackground("#e2f0d9")
    .setFontColor("#385723")
    .setRanges([range])
    .build());

  rules.push(SpreadsheetApp.newConditionalFormatRule()
    .whenTextEqualTo("PUBLISHED")
    .setBackground("#e2f0d9")
    .setFontColor("#385723")
    .setRanges([range])
    .build());

  // BRIEF / REVIEW -> light yellow
  rules.push(SpreadsheetApp.newConditionalFormatRule()
    .whenTextEqualTo("REVIEW")
    .setBackground("#fff2cc")
    .setFontColor("#7f6000")
    .setRanges([range])
    .build());

  rules.push(SpreadsheetApp.newConditionalFormatRule()
    .whenTextEqualTo("BRIEF")
    .setBackground("#fff2cc")
    .setFontColor("#7f6000")
    .setRanges([range])
    .build());

  // DESIGN_STARTED / CONTENT_RECEIVED -> light blue
  rules.push(SpreadsheetApp.newConditionalFormatRule()
    .whenTextEqualTo("DESIGN_STARTED")
    .setBackground("#ddebf7")
    .setFontColor("#1f4e78")
    .setRanges([range])
    .build());

  rules.push(SpreadsheetApp.newConditionalFormatRule()
    .whenTextEqualTo("CONTENT_RECEIVED")
    .setBackground("#ddebf7")
    .setFontColor("#1f4e78")
    .setRanges([range])
    .build());

  sheet.setConditionalFormatRules(rules);
  Logger.log("Applied creative status conditional formatting rules.");
}
